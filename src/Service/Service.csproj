<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- git submodule (fork with GetManifestAsync(validateStreams: false)); the RPM build unpacks the same source next to the tree -->
    <YoutubeExplodeProject Condition="'$(YoutubeExplodeProject)' == '' and Exists('$(MSBuildThisFileDirectory)../../third_party/YoutubeExplode/YoutubeExplode/YoutubeExplode.csproj')">$(MSBuildThisFileDirectory)../../third_party/YoutubeExplode/YoutubeExplode/YoutubeExplode.csproj</YoutubeExplodeProject>
    <YoutubeExplodeProject Condition="'$(YoutubeExplodeProject)' == ''">$(MSBuildThisFileDirectory)../../../YoutubeExplode/YoutubeExplode/YoutubeExplode.csproj</YoutubeExplodeProject>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Service</RootNamespace>
    <AssemblyName>Service</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.67.0.3358" />
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />
    <PackageReference Include="morelinq" Version="4.1.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.0" />
    <!-- The peer checkout carries a TV client that works with a logged-in session (CookiesFile); fall back to the package. -->
    <PackageReference Include="YoutubeExplode" Version="6.6.3" Condition="!Exists('$(YoutubeExplodeProject)')" />
    <ProjectReference Include="$(YoutubeExplodeProject)" Condition="Exists('$(YoutubeExplodeProject)')" />
  </ItemGroup>
</Project>
