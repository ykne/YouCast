# YouCast in an EL10 container, installed from the RPM (tested with podman on Oracle Linux 9.8).
#
#   podman build -f packaging/Containerfile -t youcast:3.0.0 "$(rpm --eval %_rpmdir)/x86_64"
#   podman volume create youcast-cache
#   podman run -d --name youcast -p 22703:22703 \
#       -v /path/to/youcast.conf:/etc/youcast.conf:ro,Z -v youcast-cache:/var/cache/youcast:Z youcast:3.0.0
#
# The build context must contain the RPM. The config file must be readable by the container's
# "youcast" user (mode 0644 on the host copy).
FROM docker.io/library/almalinux:10
ARG RPM=youcast-3.0.0-1.x86_64.rpm
# epel-release provides ffmpeg-free, which the RPM requires.
COPY ${RPM} /tmp/
RUN dnf -y install epel-release && dnf -y install /tmp/${RPM} \
    && dnf clean all && rm -f /tmp/*.rpm \
    && install -d -o youcast -g youcast /var/cache/youcast
USER youcast
EXPOSE 22703
CMD ["/usr/libexec/youcast/youcast", "--conf", "/etc/youcast.conf"]
